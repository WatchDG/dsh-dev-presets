{
  "name": "dsh-dev-presets",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Development-role agent presets for DeepSeek Harness: declarative bundle presets that compose a session's identity, tools, prompt sections, and context.",
  "license": "Apache-2.0",
  "author": "Baranov Grigoriy Vladimirovich",
  "homepage": "https://github.com/WatchDG/dsh-dev-presets#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WatchDG/dsh-dev-presets.git"
  },
  "bugs": {
    "url": "https://github.com/WatchDG/dsh-dev-presets/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-preset",
    "presets",
    "architect",
    "implementer",
    "reviewer",
    "model",
    "settings",
    "code-review",
    "cordis"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "presets/*.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.ru.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test",
    "test:unit": "node --test test/manifest.test.mjs test/presets.test.mjs test/preset-model.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/architect.patch.yml",
        "./presets/implementer.patch.yml",
        "./presets/reviewer.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "yaml": "^2.9.1"
  }
}
